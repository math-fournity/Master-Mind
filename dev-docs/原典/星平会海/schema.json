                {"id": "卷一/星曜躔度歌/轸/土-天柱", "star": "土", "name": "天柱", "text": "财帛豪强定富荣。腾达声名人仰羡，只恐多灾疾病增。"},
                {"id": "卷一/星曜躔度歌/轸/火-天暴", "star": "火", "name": "天暴", "text": "手足疯狂多颠倒。晚年衣食稍平安，只恐妻儿命难保。"},
                {"id": "卷一/星曜躔度歌/轸/金-天程", "star": "金", "name": "天程", "text": "口舌轻狂凶害生。言语不真心泛滥，多端非礼有奸名。"},
                {"id": "卷一/星曜躔度歌/轸/水-天岑", "star": "水", "name": "天岑", "text": "文学之官众所钦。谋略聪明人倍重，才华藻思人儒林。"},
                {"id": "卷一/星曜躔度歌/轸/日-天阶", "star": "日", "name": "天阶", "text": "年少功名自鼎来。端洁为人须大量，定须九棘与三槐。"},
                {"id": "卷一/星曜躔度歌/轸/月-天理", "star": "月", "name": "天理", "text": "勇智多端文学取。少年心苦老丰隆，赫突声名传万里。"},
                {"id": "卷一/星曜躔度歌/轸/气-天嗟", "star": "气", "name": "天嗟", "text": "孙子丰隆后必乖。命若逢之身独喜，此人衣食稍宽怀。"},
                {"id": "卷一/星曜躔度歌/轸/孛-天忒", "star": "孛", "name": "天忒", "text": "恋酒迷花好游奕。家财破尽好行偷，若不投军须有克。"},
                {"id": "卷一/星曜躔度歌/轸/罗-天神", "star": "罗", "name": "天神", "text": "武职之官此位逢。生杀之权心自纵，金吾节度两斑同。"},
                {"id": "卷一/星曜躔度歌/轸/计-天强", "star": "计", "name": "天强", "text": "宫职须教训练场。节度兵刑须大佐，谋猷奋迅佐朝堂。"}
              ],
              "interpretation": "轸水蚓升殿，火行度利主。火化暴星，性急多凶。受制不显。蛇为廉物，不审如是。水得旺庙。得十八度。水星升败。子孙难靠。穿睿之人。心怀报国，节度，即今总兵官取。"
            }
