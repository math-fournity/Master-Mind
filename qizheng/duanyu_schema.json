{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "七政四余断语库schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "source", "text"],
    "properties": {
      "id": {"type": "integer", "description": "唯一ID"},
      "source": {"type": "string", "description": "来源书名，如'星学大成'"},
      "volume": {"type": "string", "description": "卷号，如'卷二十'"},
      "condition": {"type": "string", "description": "触发条件表达式（同rules_library.json语法）"},
      "text": {"type": "string", "description": "断语原文"},
      "tags": {"type": "array", "items": {"type": "string"}, "description": "标签，如['富贵','贫贱','婚姻']"},
      "priority": {"type": "number", "description": "优先级"},
      "sign": {"type": "string", "enum": ["+","-","="], "description": "+吉-凶=中性"}
    }
  }
}
