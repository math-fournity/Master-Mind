  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # sum(b^3) = -n: k*x^3 + (n-k-1)*y^3 + z^3 = -n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # 3 equations, 3 unknowns (x, y, z)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    from sympy import symbols, solve, sqrt, N[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    x, y, z = symbols('x y z', real=True)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    eqs = [[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        k*x + (n-k-1)*y + z,[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        k*x**2 + (n-k-1)*y**2 + z**2 - n,[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        k*x**3 + (n-k-1)*y**3 + z**3 + n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    ][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    sols = solve(eqs, [x, y, z])[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    results = [][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for sol in sols:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        try:[0m
