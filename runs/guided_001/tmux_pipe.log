  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for _ in range(200):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        z = -k*x - (n-k-1)*y[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        f1 = k*x**2 + (n-k-1)*y**2 + z**2 - n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        f2 = k*x**3 + (n-k-1)*y**3 + z**3 + n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        dz_dx, dz_dy = -k, -(n-k-1)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        df1_dx = 2*k*x + 2*z*dz_dx[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        df1_dy = 2*(n-k-1)*y + 2*z*dz_dy[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        df2_dx = 3*k*x**2 + 3*z**2*dz_dx[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        df2_dy = 3*(n-k-1)*y**2 + 3*z**2*dz_dy[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        det = df1_dx*df2_dy - df1_dy*df2_dx[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if abs(det) < 1e-15:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            return None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        dx = (f1*df2_dy - f2*df1_dy) / det[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        dy = (df1_dx*f2 - df2_dx*f1) / det[0m
