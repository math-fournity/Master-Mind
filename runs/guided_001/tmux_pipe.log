  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return results[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mphi = (1 + np.sqrt(5)) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mp_opt = phi / np.sqrt(5)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint(f'Target: sqrt(5) = {np.sqrt(5):.6f}')[0m
