  [38;2;68;68;68m│[0m   [38;2;206;145;120mfor n in [4, 5, 10, 20, 50, 100, 1000]:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    best_d = float('inf')[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    best_config = None[0m
