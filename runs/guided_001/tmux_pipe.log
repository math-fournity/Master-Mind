  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport numpy as np[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mfrom scipy.optimize import minimize[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For given n, minimize max(b)-min(b) subject to sum(b)=0, sum(b^2)=n, [0m
