  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if abs(dx) < 1e-14 and abs(dy) < 1e-14:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            break[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    z = -k*x - (n-k-1)*y[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    r1 = k*x + (n-k-1)*y + z[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    r2 = k*x**2 + (n-k-1)*y**2 + z**2 - n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    r3 = k*x**3 + (n-k-1)*y**3 + z**3 + n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    if abs(r1) < 1e-8 and abs(r2) < 1e-8 and abs(r3) < 1e-8:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        d = max(x, y, z) - min(x, y, z)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if d > 0 and d < 100:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            return d, (x, y, z)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mphi = (1 + np.sqrt(5)) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mp_opt = phi / np.sqrt(5)[0m
