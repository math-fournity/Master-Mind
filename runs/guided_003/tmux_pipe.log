  [38;2;68;68;68m│[0m   [38;2;206;145;120m        c = (S + np.sqrt(disc)) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if m - 1e-6 <= b <= M + 1e-6 and m - 1e-6 <= c <= M + 1e-6:[0m
