  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 极限满足两值构型的矩方程, 解唯一 = (x0, y0)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 关键: 两值构型的解唯一吗?[0m
