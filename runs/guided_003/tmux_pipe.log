  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint(f"\n解: a = {simplify(sol[a_val])}")[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint(f"    b = {simplify(sol[b_val])}")[0m
