  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 当 n->∞: alpha -> p, beta -> 0, gamma -> 1-p[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 方程退化为: p*x + (1-p)*y = 1, p*x^2 + (1-p)*y^2 = 2, p*x^3 + (1-p)*y^3 [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m= 3[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 解为 x=x0, y=y0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 对有限 n, beta = 1/n > 0, w 是额外自由度[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 由隐函数定理 (在 beta=0, w=y0 附近):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 但雅可比退化 (w=y 时)...[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 换个角度: 直接解三值构型, 看 w-y 的渐近行为[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 用扰动展开: x = x0 + a/n, y = y0 + b/n, w = y0 + c/n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120malpha, beta, gamma = symbols('alpha beta gamma', real=True)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mx, y, w = symbols('x y w', real=True)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120ma, b, c = symbols('a b c', real=True)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mx0 = (1 - sqrt(5)) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120my0 = (1 + sqrt(5)) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mp = (5 - sqrt(5)) / 10[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# alpha = p + da/n, beta = 1/n, gamma = 1 - p - (da+1)/n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mda = symbols('da', real=True)  # alpha - p 的 n 倍[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# x = x0 + a/n, y = y0 + b/n, w = y0 + c/n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 代入 alpha*x + beta*w + gamma*y = 1[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (p + da/n)(x0 + a/n) + (1/n)(y0 + c/n) + (1-p-(da+1)/n)(y0 + b/n) = 1[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 展开到 O(1/n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# p*x0 + (1-p)*y0 + (1/n)[da*x0 + p*a + y0 + (1-p)*b - (da+1)*y0] = 1[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# p*x0 + (1-p)*y0 = 1 (精确)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 所以 da*x0 + p*a + y0 + (1-p)*b - (da+1)*y0 = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# da*x0 + p*a + (1-p)*b - da*y0 = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# da*(x0 - y0) + p*a + (1-p)*b = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# -da*sqrt(5) + p*a + (1-p)*b = 0  ... (I)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("O(1/n) 方程:")[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("(I): -da*√5 + p*a + (1-p)*b = 0")[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 代入二阶矩: alpha*x^2 + beta*w^2 + gamma*y^2 = 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (p+da/n)(x0+a/n)^2 + (1/n)(y0+c/n)^2 + (1-p-(da+1)/n)(y0+b/n)^2 = 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# O(1): p*x0^2 + (1-p)*y0^2 = 2 (精确, 因为 x0^2=x0+1, y0^2=y0+1)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# O(1/n): da*x0^2 + 2p*x0*a + y0^2 + 2(1-p)*y0*b - (da+1)*y0^2 = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# da*(x0^2 - y0^2) + 2p*x0*a + 2(1-p)*y0*b = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# da*(-sqrt(5)) + 2p*x0*a + 2(1-p)*y0*b = 0  ... (II)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (x0^2 - y0^2 = (x0-y0)(x0+y0) = -sqrt(5)*1 = -sqrt(5))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("(II): -da*√5 + 2p*x0*a + 2(1-p)*y0*b = 0")[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 代入三阶矩: alpha*x^3 + beta*w^3 + gamma*y^3 = 3[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# O(1/n): da*(x0^3 - y0^3) + 3p*x0^2*a + 3(1-p)*y0^2*b = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# x0^3 - y0^3 = -3*sqrt(5) (之前算过)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("(III): -3*da*√5 + 3p*x0^2*a + 3(1-p)*y0^2*b = 0")[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 注意: c (w 的修正) 在 O(1/n) 不出现! 因为 beta = 1/n, beta*c/n = c/n^2 =[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mO(1/n^2)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 所以 w 的修正在更高阶才影响矩. 这意味着 c 是自由的 (到 O(1/n))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 而 a, b 由 (I), (II), (III) 中的两个确定[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 从 (I) 和 (II):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (I): p*a + (1-p)*b = da*sqrt(5)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (II): 2p*x0*a + 2(1-p)*y0*b = da*sqrt(5)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 除 (II) by 2: p*x0*a + (1-p)*y0*b = da*sqrt(5)/2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (I) - 上面: p*(1-x0)*a + (1-p)*(1-y0)*b = da*sqrt(5)/2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 1-x0 = (1+sqrt(5))/2 = y0, 1-y0 = (1-sqrt(5))/2 = x0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# p*y0*a + (1-p)*x0*b = da*sqrt(5)/2  ... (IV)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 从 (I): p*a + (1-p)*b = da*sqrt(5)  ... (I)[0m
