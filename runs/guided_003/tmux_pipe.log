  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [1,     1,     1    ][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [2*x0,  2*y0,  2*y0 ][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [3*x0^2,3*y0^2,3*y0^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 列 2 和列 3 还是相同! 需要至少 2 个 x0 或 2 个不同位置的微调[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 更好: 把 1 个 x0 -> x0+f, 1 个 y0 -> y0+e1, 1 个 y0 -> y0+e2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 但 e1, e2 的列相同. 改成:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 把 1 个 x0 -> x0+f1, 1 个 x0 -> x0+f2, 1 个 y0 -> y0+e[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 雅可比 (对 f1, f2, e):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [1,    1,    1    ][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [2*x0, 2*x0, 2*y0 ][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [3*x0^2,3*x0^2,3*y0^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 列 1,2 还是相同![0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 根本问题: 同值的微调在一阶上不可区分[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 需要微调 3 个不同值的变量, 但两值构型只有 2 个不同值[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 解决: 用三值构型作为初始, 或用二阶修正[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 方案: 把 1 个 x0 -> x0+f, 1 个 y0 -> y0+e1, 1 个 y0 -> y0+e2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 一阶: 列2=列3, 退化[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 但二阶: e1^2 ≠ e2^2 如果 e1 ≠ e2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 用牛顿法/二阶隐函数定理[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 或者更简单: 用 3 个不同的修正[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 把 1 个 x0 -> a, 1 个 y0 -> b, 1 个 y0 -> c (3 个独立新值)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 3 个方程, 3 个未知 a, b, c[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 雅可比 (对 a, b, c):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [1, 1, 1][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [2a, 2b, 2c]  -> 在 a=x0, b=c=y0 处: [1,1,1]; [2x0,2y0,2y0]; [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m[3x0^2,3y0^2,3y0^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [3a^2, 3b^2, 3c^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 列 2 = 列 3 (b=c=y0), 退化[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 必须让 3 个修正值不同. 用:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# k-1 个 x0, 1 个 a, 1 个 b, n-k-2 个 y0, 1 个 c  (a,b,c 三个不同新值)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 但这需要 n-k-2 >= 0, 即 n >= k+2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 雅可比 (对 a, b, c) 在 a=x0, b=y0, c=y0:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [1, 1, 1][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [2x0, 2y0, 2y0]  [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [3x0^2, 3y0^2, 3y0^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 还是列2=列3![0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 关键: 需要两个修正点有不同的初始值. [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 用: k-1 个 x0, 1 个 a, n-k-2 个 y0, 1 个 b, 1 个 c[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# a 代替一个 x0, b,c 代替两个 y0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 在 a=x0, b=y0, c=y0: 列1 = [1, 2x0, 3x0^2], 列2=列3 = [1, 2y0, 3y0^2][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 退化[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 唯一办法: 3 个修正点初始值两两不同, 但只有 2 个值[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 所以需要三值构型作为起点![0m
