  [38;2;68;68;68m│[0m   [38;2;206;145;120mfrom sympy import *[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# ========== 方向 1-2：辅助多项式第一步 ==========[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mm, M, n = symbols('m M n', real=True)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (a_i - m)(a_i - M) <= 0 for all a_i in [m, M][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# sum (a_i - m)(a_i - M) <= 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# = sum a_i^2 - (m+M) sum a_i + n*m*M <= 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# = 2n - (m+M)*n + n*m*M <= 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 除以 n: 2 - (m+M) + mM <= 0[0m
