  [38;2;68;68;68m│[0m $ [38;2;220;220;170mcd[0m /data/math-agent-glm5.2-2 [38;2;255;255;255m&&[0m [38;2;220;220;170mtimeout[0m 20 python3 << [38;2;206;145;120m'EOF'[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport numpy as np[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef explore_n(n_val):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    """对给定 n, 扫描 min=a, 用矩约束解 max=d, 检查可行性, 找最小极差"""[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    best_spread = float('inf')[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    best_config = None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # 第三矩约束: a^3 + (S^3 - 3*S*P) + d^3 = 3n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # S = n - a - d, P = (S^2 - (2n - a^2 - d^2))/2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # 即 a^3 + S^3 - 3*S*P + d^3 = 3n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for a in np.linspace(-3, 1, 2000):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        # 对每个 a, 数值解 d[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        def third_eq(d):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            S = n_val - a - d[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            Q = 2*n_val - a**2 - d**2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            P = (S**2 - Q) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            return a**3 + S**3 - 3*S*P + d**3 - 3*n_val[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        # 扫描 d[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        for d_start in np.linspace(a+0.01, 5, 500):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            try:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                val = third_eq(d_start)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                val_next = third_eq(d_start + 0.01)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                if val * val_next < 0:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    # 二分法[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    lo, hi = d_start, d_start + 0.01[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    for _ in range(100):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                        mid = (lo + hi) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                        if third_eq(mid) * third_eq(lo) < 0:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                            hi = mid[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                        else:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                            lo = mid[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    d = (lo + hi) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    if d <= a:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                        continue[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    S = n_val - a - d[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    Q = 2*n_val - a**2 - d**2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                    P = (S**2 - Q) / 2[0m
