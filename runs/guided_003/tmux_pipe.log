  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef eq(M, m):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return 3*M**3 + 3*M**2*m - 12*M**2 + 3*M*m**2 - 12*M*m + 12*M + 3*m**3[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m- 12*m**2 + 12*m + 4[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mbest_spread = float('inf')[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mbest = None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 扫描 m[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mfor m in np.linspace(-3, 2, 10000):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # 对每个 m, 找 M 的根[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # 用密集扫描找变号区间[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    prev = eq(m - 0.001, m)  # 不对，应该扫描 M[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    Ms = np.linspace(m + 0.001, 6, 5000)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    vals = np.array([eq(M, m) for M in Ms])[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    sign_changes = np.where(np.diff(np.sign(vals)))[0][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for idx in sign_changes:[0m
