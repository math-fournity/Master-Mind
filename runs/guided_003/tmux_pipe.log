  [38;2;68;68;68m│[0m   [38;2;206;145;120m                hi = mid[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            else:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                lo = mid[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        M = (lo + hi) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if M <= m:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            continue[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        # 检查 b, c 实数且在 [m, M] 内[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        S = 4 - m - M[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        Q = 8 - m**2 - M**2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        bc = (S**2 - Q) / 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        disc = S**2 - 4*bc[0m
