  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport numpy as np[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 超出量*n 不稳定, 因为 fsolve 精度不够, 且最优 k 不一定是 round(p*n)[0m
