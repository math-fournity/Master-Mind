  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 用弱收敛 + 矩连续性[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 取 k_n/n -> p (Dirichlet), 三值构型解 (x_n, y_n, w_n)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 经验测度 mu_n = (k_n/n)*delta_{x_n} + (1/n)*delta_{w_n} + (1-k_n/n-1/[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mn)*delta_{y_n}[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# mu_n 的前三阶矩 = (1, 2, 3) 精确[0m
