{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/local-root-receipt.schema.json",
  "title": "Seven Local Append-once Root Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "epoch_id", "manifest_hash", "index_hash", "previous_receipt_hash", "generated_at", "trust_scope", "receipt_hash"],
  "properties": {
    "schema_version": {"const": "local-root-receipt/v1"},
    "receipt_kind": {"enum": ["INITIAL_SCAFFOLD", "P1_DRY_RUN"]},
    "epoch_id": {"type": "string"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "index_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_receipt_hash": {"type": ["string", "null"]},
    "generated_at": {"type": "string"},
    "trust_scope": {"const": "LOCAL_APPEND_ONCE_API_NOT_WORM"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
