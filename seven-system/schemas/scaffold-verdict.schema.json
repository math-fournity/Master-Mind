{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/scaffold-verdict.schema.json",
  "title": "Seven System Scaffold Verdict v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "factory_pipeline", "p0_static_preflight", "p1_dry_run_primitives", "p1_orchestration", "scientific_analyzability", "tell_evidence", "overall_verdict"],
  "properties": {
    "schema_version": {"const": "scaffold-verdict/v1"},
    "epoch_id": {"type": "string"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "factory_pipeline": {"const": "NOT_TESTED"},
    "p0_static_preflight": {"enum": ["PASS", "FAIL"]},
    "p1_dry_run_primitives": {"enum": ["READY", "PASS", "FAIL"]},
    "p1_orchestration": {"enum": ["NOT_IMPLEMENTED", "SCAFFOLD_GATE_PASS", "FAIL"]},
    "scientific_analyzability": {"const": "NOT_TESTED"},
    "tell_evidence": {"const": "NOT_TESTED"},
    "overall_verdict": {"type": "string"}
  }
}
