{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/gate-decision.schema.json",
  "title": "Seven Gate Decision v1",
  "type": "object",
  "required": ["schema_version", "gate_id", "phase_id", "epoch_id", "manifest_hash", "generated_at", "verdict", "evidence", "implementation_ceiling"],
  "properties": {
    "schema_version": {"const": "gate-decision/v1"},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
    "evidence": {"type": "array", "minItems": 1}
  }
}
