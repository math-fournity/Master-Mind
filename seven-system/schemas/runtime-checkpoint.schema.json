{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/runtime-checkpoint.schema.json",
  "title": "Seven Runtime Checkpoint v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "state", "ledger_cursor", "active_leases"],
  "properties": {
    "schema_version": {"const": "runtime-checkpoint/v1"},
    "epoch_id": {"type": "string"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"type": "string"},
    "ledger_cursor": {"type": "integer", "minimum": 0},
    "active_leases": {"type": "array"}
  }
}
