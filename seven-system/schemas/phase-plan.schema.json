{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/phase-plan.schema.json",
  "title": "Seven System Phase Plan v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "implementation_ceiling", "phases", "stop_condition"],
  "properties": {
    "schema_version": {"const": "phase-plan/v1"},
    "epoch_id": {"type": "string"},
    "manifest_hash": {"type": "string"},
    "implementation_ceiling": {"const": "P1"},
    "phases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["phase_id", "name", "dependencies", "status", "gate"]
      }
    },
    "stop_condition": {"type": "string"}
  }
}
