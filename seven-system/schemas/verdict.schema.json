{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/verdict.schema.json",
  "title": "Seven System Golden Slice Verdict v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "factory_pipeline", "scientific_analyzability", "tell_evidence", "six_gates", "blockers", "explicit_nonclaims", "overall_verdict"],
  "properties": {
    "schema_version": {"const": "golden-slice-verdict/v1"},
    "factory_pipeline": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"]},
    "scientific_analyzability": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_TESTED"]},
    "tell_evidence": {"enum": ["SUPPORTS", "CONTRADICTS", "DOES_NOT_SUPPORT", "INCONCLUSIVE_DUE_TO_PROTOCOL", "NOT_TESTED"]},
    "six_gates": {"type": "object"},
    "blockers": {"type": "array"},
    "explicit_nonclaims": {"type": "array"},
    "overall_verdict": {"type": "string"}
  }
}
