{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/runtime-manifest.schema.json",
  "title": "Seven System Runtime Manifest v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "generated_at", "mode", "config_hash", "manifest_hash", "repositories", "database", "storage", "runtime", "inputs", "outputs", "implementation"],
  "properties": {
    "schema_version": {"const": "runtime-manifest/v1"},
    "epoch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "generated_at": {"type": "string"},
    "mode": {"enum": ["dry_run", "golden_slice", "continuous", "fault_injection"]},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositories": {"type": "object"},
    "database": {"type": "object"},
    "storage": {"type": "object"},
    "runtime": {"type": "object"},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "implementation": {"type": "object"}
  }
}
