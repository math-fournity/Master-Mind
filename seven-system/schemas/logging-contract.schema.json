{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/logging-contract.schema.json",
  "title": "Seven Logging Contract v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "required_context", "event_format", "redaction", "alert_actions"],
  "properties": {
    "schema_version": {"const": "logging-contract/v1"},
    "epoch_id": {"type": "string"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
