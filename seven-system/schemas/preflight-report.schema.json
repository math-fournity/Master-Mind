{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/preflight-report.schema.json",
  "title": "Seven System Preflight Report v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "system_id", "mode", "overall_verdict", "implementation_ceiling", "checks", "blockers", "side_effects"],
  "properties": {
    "schema_version": {"const": "preflight-report/v1"},
    "overall_verdict": {"enum": ["PASS", "PARTIAL", "BLOCKED"]},
    "implementation_ceiling": {"const": "P1_DRY_RUN"},
    "checks": {"type": "array"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "side_effects": {"const": "NONE"}
  }
}
