{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/seven-system/dry-run-report.schema.json",
  "title": "Seven P1 Scaffold Dry-run Report v1",
  "type": "object",
  "required": ["schema_version", "epoch_id", "manifest_hash", "generated_at", "verdict", "checks", "side_effects", "scientific_claim"],
  "properties": {
    "schema_version": {"const": "dry-run-report/v1"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "scientific_claim": {"const": "NOT_TESTED"}
  }
}
