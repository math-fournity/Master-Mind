{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/docs/doc-bootstrap-completion-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_id", "wp_id", "implementation_subject", "work_package_plan_ref_and_hash", "normative_index_ref_and_hash", "test_receipts", "side_effect_counts", "storage_assurance", "claims", "nonclaims", "created_at", "creator", "record_hash_algorithm", "record_hash"],
  "properties": {
    "schema_id": {"const": "seven/docs/doc-bootstrap-completion-record"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "wp_id": {"const": "WP-DOC0"},
    "implementation_subject": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "work_package_plan_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "normative_index_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "test_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref_hash"}},
    "side_effect_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db_connections", "db_writes", "redis_connections", "remote_model_calls", "target_solver_launches", "d_volume_writes"],
      "properties": {
        "db_connections": {"const": 0},
        "db_writes": {"const": 0},
        "redis_connections": {"const": 0},
        "remote_model_calls": {"const": 0},
        "target_solver_launches": {"const": 0},
        "d_volume_writes": {"const": 0}
      }
    },
    "storage_assurance": {"const": "LOCAL_GIT_APPEND_ONLY_NOT_CAS"},
    "claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "creator": {"type": "string", "minLength": 1},
    "record_hash_algorithm": {"const": "sha256(canonical-json-with-record_hash-null)"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {"ref_hash": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
