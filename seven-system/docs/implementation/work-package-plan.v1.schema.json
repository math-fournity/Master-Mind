{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/work-package-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "wp_id", "implementation_attempt_id", "plan_timing", "protocol_deviations", "baseline", "canonical_dag", "development_dependency_bundles", "inherited_audit_debt", "activation_dependencies", "normative_index_ref_and_hash", "normative_review_record_ref_and_hash", "requirement_ids", "normative_clause_ids", "normative_clause_scope", "normative_spec_refs_and_hashes", "goals", "non_goals", "allowed_path_rules", "forbidden_boundaries", "input_object_types_and_hashes", "output_object_types", "interfaces_and_schema_ids", "state_machines_and_registries", "security_and_view_contracts", "idempotency_fence_recovery_rules", "test_plan_ids", "external_execution_authorization_ref", "live_run_permit_ref", "authorization_consumption_reservation_ref", "side_effect_budget", "pass_criteria", "stop_conditions", "explicit_nonclaims", "plan_hash_algorithm", "plan_hash"],
  "properties": {
    "schema_id": {"const": "seven/work-package-plan"},
    "schema_version": {"const": 1},
    "wp_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
    "implementation_attempt_id": {"type": "string", "minLength": 1},
    "plan_timing": {"enum": ["PREREGISTERED", "DOC0_BOOTSTRAP_RATIFICATION"]},
    "execution_mode": {"enum": ["SIDE_EFFECT_FREE", "AUTHORIZED_LIVE_CANARY"]},
    "protocol_deviations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "baseline": {"$ref": "#/$defs/commit_tree"},
    "canonical_dag": {"$ref": "#/$defs/ref_hash"},
    "development_dependency_bundles": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}},
    "inherited_audit_debt": {"type": "array", "items": {"type": "string"}},
    "activation_dependencies": {"type": "array", "items": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"}, "uniqueItems": true},
    "normative_index_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "normative_review_record_ref_and_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref_hash"}]},
    "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "normative_clause_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NORM-"}, "uniqueItems": true},
    "normative_clause_scope": {"type": "string", "minLength": 1},
    "normative_spec_refs_and_hashes": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}},
    "goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_path_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_object_types_and_hashes": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}},
    "output_object_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "interfaces_and_schema_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "state_machines_and_registries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "security_and_view_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "idempotency_fence_recovery_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "test_plan_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "external_execution_authorization_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref_hash"}]},
    "live_run_permit_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref_hash"}]},
    "authorization_consumption_reservation_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref_hash"}]},
    "side_effect_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db_connections", "db_writes", "redis_connections", "remote_model_calls", "target_solver_launches", "d_volume_writes"],
      "properties": {
        "db_connections": {"type": "integer", "minimum": 0},
        "db_writes": {"type": "integer", "minimum": 0},
        "redis_connections": {"type": "integer", "minimum": 0},
        "remote_model_calls": {"type": "integer", "minimum": 0},
        "target_solver_launches": {"type": "integer", "minimum": 0},
        "d_volume_writes": {"type": "integer", "minimum": 0}
      }
    },
    "pass_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "explicit_nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "plan_hash_algorithm": {"const": "sha256(canonical-json-with-plan_hash-null)"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"wp_id": {"const": "WP-DOC0"}}, "required": ["wp_id"]},
      "then": {
        "properties": {
          "execution_mode": {"const": "SIDE_EFFECT_FREE"},
          "normative_review_record_ref_and_hash": {"type": "null"},
          "external_execution_authorization_ref": {"type": "null"},
          "live_run_permit_ref": {"type": "null"},
          "authorization_consumption_reservation_ref": {"type": "null"},
          "side_effect_budget": {
            "properties": {
              "db_connections": {"const": 0},
              "db_writes": {"const": 0},
              "redis_connections": {"const": 0},
              "remote_model_calls": {"const": 0},
              "target_solver_launches": {"const": 0},
              "d_volume_writes": {"const": 0}
            }
          }
        }
      },
      "else": {
        "required": ["execution_mode"],
        "properties": {"normative_review_record_ref_and_hash": {"$ref": "#/$defs/ref_hash"}}
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "SIDE_EFFECT_FREE"}}, "required": ["execution_mode"]},
      "then": {
        "properties": {
          "external_execution_authorization_ref": {"type": "null"},
          "live_run_permit_ref": {"type": "null"},
          "authorization_consumption_reservation_ref": {"type": "null"},
          "side_effect_budget": {
            "properties": {
              "db_connections": {"const": 0},
              "db_writes": {"const": 0},
              "redis_connections": {"const": 0},
              "remote_model_calls": {"const": 0},
              "target_solver_launches": {"const": 0},
              "d_volume_writes": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "AUTHORIZED_LIVE_CANARY"}}, "required": ["execution_mode"]},
      "then": {
        "properties": {
          "external_execution_authorization_ref": {"$ref": "#/$defs/ref_hash"},
          "live_run_permit_ref": {"$ref": "#/$defs/ref_hash"},
          "authorization_consumption_reservation_ref": {"$ref": "#/$defs/ref_hash"},
          "side_effect_budget": {
            "anyOf": [
              {"properties": {"db_connections": {"minimum": 1}}, "required": ["db_connections"]},
              {"properties": {"db_writes": {"minimum": 1}}, "required": ["db_writes"]},
              {"properties": {"redis_connections": {"minimum": 1}}, "required": ["redis_connections"]},
              {"properties": {"remote_model_calls": {"minimum": 1}}, "required": ["remote_model_calls"]},
              {"properties": {"target_solver_launches": {"minimum": 1}}, "required": ["target_solver_launches"]},
              {"properties": {"d_volume_writes": {"minimum": 1}}, "required": ["d_volume_writes"]}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ref_hash": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "commit_tree": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
  }
}
