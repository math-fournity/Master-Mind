{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/docs/doc-bootstrap-import-anchor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "bootstrap_record_ref_and_hash", "cas_artifact_ref_and_hash", "byte_equality_verified", "vlt0_capability_report_ref_and_hash", "imported_at"],
  "properties": {
    "schema_id": {"const": "seven/docs/doc-bootstrap-import-anchor"},
    "schema_version": {"const": 1},
    "bootstrap_record_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "cas_artifact_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "byte_equality_verified": {"const": true},
    "vlt0_capability_report_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "imported_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"ref_hash": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
