{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/audit-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "audit_id",
    "wp_id",
    "audit_assignment_ref_and_hash",
    "assignment_verification_receipt_ref_and_hash",
    "audited_bundle_ref_and_hash",
    "audited_subject",
    "evidence_index_commit_if_any",
    "externally_observed_pinned_trust_root",
    "runtime_manifest_trust_root_hash",
    "audit_plan_and_spec_refs_and_hashes",
    "auditor_principal_id",
    "auditor_attestation_key_id",
    "auditor_attestation_public_key_hash",
    "auditor_session_attestation_ref_and_hash",
    "independence_evidence",
    "findings",
    "replayed_test_receipts",
    "external_execution_receipts",
    "traceability_remainder",
    "orphan_remainder",
    "claims_confirmed",
    "claims_rejected",
    "nonclaims_checked",
    "axis_verdicts",
    "scope_limits",
    "followups",
    "state_transition_effect",
    "created_at",
    "canonicalizer_profile",
    "signature_domain",
    "signed_bytes_hash",
    "signature_envelope",
    "audit_record_hash_algorithm",
    "audit_record_hash"
  ],
  "properties": {
    "schema_id": {"const": "seven/audit-record"},
    "schema_version": {"const": 1},
    "audit_id": {"type": "string", "minLength": 1},
    "wp_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
    "audit_assignment_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "assignment_verification_receipt_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "audited_bundle_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "audited_subject": {"$ref": "#/$defs/commit_tree"},
    "evidence_index_commit_if_any": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/commit_tree"}
      ]
    },
    "externally_observed_pinned_trust_root": {"$ref": "#/$defs/external_root_observation"},
    "runtime_manifest_trust_root_hash": {"$ref": "#/$defs/hash"},
    "audit_plan_and_spec_refs_and_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref_hash"}
    },
    "auditor_principal_id": {"type": "string", "minLength": 1},
    "auditor_attestation_key_id": {"type": "string", "minLength": 1},
    "auditor_attestation_public_key_hash": {"$ref": "#/$defs/hash"},
    "auditor_session_attestation_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "independence_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref_hash"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "replayed_test_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref_hash"}
    },
    "external_execution_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref_hash"}
    },
    "traceability_remainder": {"type": "integer", "minimum": 0},
    "orphan_remainder": {"type": "integer", "minimum": 0},
    "claims_confirmed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claims_rejected": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonclaims_checked": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "axis_verdicts": {"$ref": "#/$defs/axis_verdicts"},
    "scope_limits": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "followups": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "state_transition_effect": {"const": "NONE_UNTIL_HUMAN_GATE_SERVICE_ACCEPTS"},
    "created_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "canonicalizer_profile": {"const": "RFC8785_JCS_UTF8"},
    "signature_domain": {"const": "seven-audit-record/v1\u0000"},
    "signed_bytes_hash": {"$ref": "#/$defs/hash"},
    "signature_envelope": {"$ref": "#/$defs/signature_envelope"},
    "audit_record_hash_algorithm": {"const": "sha256(RFC8785-JCS-object-with-audit_record_hash-null)"},
    "audit_record_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "ref_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "commit_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "external_root_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_root_hash", "source_channel_id", "observed_at", "observation_receipt_ref_and_hash"],
      "properties": {
        "trust_root_hash": {"$ref": "#/$defs/hash"},
        "source_channel_id": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
        "observation_receipt_ref_and_hash": {"$ref": "#/$defs/ref_hash"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "finding_kind", "severity", "status", "affected_axes", "requirement_ids", "summary", "evidence_refs"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "finding_kind": {"enum": ["STATIC", "DYNAMIC", "FAULT_INJECTION", "TRACEABILITY", "SECURITY", "SCIENTIFIC", "SCALE"]},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "status": {"enum": ["OPEN", "RESOLVED_BY_AUDITED_SUBJECT", "ACCEPTED_SCOPE_LIMIT"]},
        "affected_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["implementation", "factory", "scientific", "production_scale"]}
        },
        "requirement_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref_hash"}}
      }
    },
    "standard_axis_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "finding_ids", "evidence_refs", "scope_reason_if_not_tested"],
      "properties": {
        "verdict": {"enum": ["AUDITED_PASS", "AUDITED_PARTIAL", "AUDITED_FAIL", "BLOCKED", "NOT_TESTED"]},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}},
        "scope_reason_if_not_tested": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "scientific_axis_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "finding_ids", "evidence_refs", "scope_reason_if_not_tested"],
      "properties": {
        "verdict": {"enum": ["SUPPORTS", "CONTRADICTS", "DOES_NOT_SUPPORT", "INCONCLUSIVE", "NOT_TESTED"]},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}},
        "scope_reason_if_not_tested": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "axis_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "factory", "scientific", "production_scale"],
      "properties": {
        "implementation": {"$ref": "#/$defs/standard_axis_verdict"},
        "factory": {"$ref": "#/$defs/standard_axis_verdict"},
        "scientific": {"$ref": "#/$defs/scientific_axis_verdict"},
        "production_scale": {"$ref": "#/$defs/standard_axis_verdict"}
      }
    },
    "signature_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signer_principal_id", "signature_encoding", "signature_b64", "signed_bytes_hash"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "signer_principal_id": {"type": "string", "minLength": 1},
        "signature_encoding": {"const": "base64"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signed_bytes_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
