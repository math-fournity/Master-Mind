{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/role-qualification-matrix/v1",
  "title": "RoleQualificationMatrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "object_type",
    "matrix_id",
    "matrix_version",
    "role_type_registry_ref_and_hash",
    "runtime_manifest_ref_and_hash",
    "qualification_scope",
    "cells",
    "completeness",
    "generated_at",
    "issuer_principal_id",
    "externally_pinned_trust_root",
    "issuer_key_registry_ref_and_hash",
    "canonicalizer_profile",
    "signature_domain",
    "signed_bytes_hash",
    "signature_envelope",
    "matrix_hash_algorithm",
    "matrix_hash",
    "supersedes_ref_and_hash"
  ],
  "properties": {
    "schema_id": {"const": "seven/role-qualification-matrix"},
    "schema_version": {"const": 1},
    "object_type": {"const": "RoleQualificationMatrix"},
    "matrix_id": {"$ref": "#/$defs/exact_string"},
    "matrix_version": {"type": "integer", "minimum": 1},
    "role_type_registry_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "runtime_manifest_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "qualification_scope": {"enum": ["CANARY", "PRODUCTION"]},
    "cells": {
      "type": "array",
      "items": {"$ref": "#/$defs/qualification_cell"}
    },
    "completeness": {"$ref": "#/$defs/completeness"},
    "generated_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "issuer_principal_id": {"$ref": "#/$defs/exact_string"},
    "externally_pinned_trust_root": {"$ref": "#/$defs/named_hash"},
    "issuer_key_registry_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "canonicalizer_profile": {"const": "RFC8785_JCS_UTF8"},
    "signature_domain": {"const": "seven-role-qualification-matrix/v1\u0000"},
    "signed_bytes_hash": {"$ref": "#/$defs/hash"},
    "signature_envelope": {"$ref": "#/$defs/signature"},
    "matrix_hash_algorithm": {"const": "sha256(RFC8785-JCS-object-with-matrix_hash-null)"},
    "matrix_hash": {"$ref": "#/$defs/hash"},
    "supersedes_ref_and_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref_hash"}]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "exact_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^*?\\[\\]{}\\r\\n]+$",
      "not": {"enum": ["ANY", "ALL", "DEFAULT", "any", "all", "default"]}
    },
    "ref_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/exact_string"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "named_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "sha256"],
      "properties": {
        "object_id": {"$ref": "#/$defs/exact_string"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "qualification_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_cell_id",
        "cell_key",
        "role_type_id",
        "carrier_id",
        "model_id",
        "carrier_profile_ref_and_hash",
        "input_view_ref_and_hash",
        "input_view_policy_ref_and_hash",
        "input_acl_policy_ref_and_hash",
        "vault_access_capability_ref_and_hash",
        "tool_network_sandbox_policy_ref_and_hash",
        "output_sensitivity_and_sink_policy_ref_and_hash",
        "prompt_release_ref_and_hash",
        "output_schema_ref_and_hash",
        "adapter_ref_and_hash",
        "parser_ref_and_hash",
        "capability_requirement_ref_and_hash",
        "qualification_level",
        "verdict",
        "capability_report_refs_and_hashes",
        "evidence_bundle_refs_and_hashes",
        "valid_from",
        "valid_until",
        "invalidated_at",
        "invalidation_reason"
      ],
      "properties": {
        "qualification_cell_id": {"$ref": "#/$defs/exact_string"},
        "cell_key": {"$ref": "#/$defs/hash"},
        "role_type_id": {"$ref": "#/$defs/exact_string"},
        "carrier_id": {"$ref": "#/$defs/exact_string"},
        "model_id": {"$ref": "#/$defs/exact_string"},
        "carrier_profile_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "input_view_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "input_view_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "input_acl_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "vault_access_capability_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "tool_network_sandbox_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "output_sensitivity_and_sink_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "prompt_release_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "output_schema_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "adapter_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "parser_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "capability_requirement_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "qualification_level": {"enum": ["CANARY", "PRODUCTION"]},
        "verdict": {"description": "未产生适用CapabilityReport的cell必须使用NOT_TESTED；NOT_QUALIFIED不是v1状态。", "enum": ["NOT_TESTED", "PASS", "PARTIAL", "FAIL", "BLOCKED", "EXPIRED"]},
        "capability_report_refs_and_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_hash"}
        },
        "evidence_bundle_refs_and_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_hash"}
        },
        "valid_from": {"$ref": "#/$defs/canonical_utc_timestamp"},
        "valid_until": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/canonical_utc_timestamp"}]},
        "invalidated_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/canonical_utc_timestamp"}]},
        "invalidation_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/exact_string"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "NOT_TESTED"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "capability_report_refs_and_hashes": {"maxItems": 0},
              "evidence_bundle_refs_and_hashes": {"maxItems": 0},
              "invalidated_at": {"type": "null"},
              "invalidation_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "capability_report_refs_and_hashes": {"minItems": 1},
              "evidence_bundle_refs_and_hashes": {"minItems": 1},
              "valid_until": {"$ref": "#/$defs/canonical_utc_timestamp"},
              "invalidated_at": {"type": "null"},
              "invalidation_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"verdict": {"enum": ["PARTIAL", "FAIL", "BLOCKED", "EXPIRED"]}}, "required": ["verdict"]},
          "then": {"properties": {"evidence_bundle_refs_and_hashes": {"minItems": 1}}}
        }
      ]
    },
    "cell_key_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/hash"},
      "uniqueItems": true
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_cell_keys",
        "pass_cell_keys",
        "not_tested_cell_keys",
        "failed_cell_keys",
        "extra_cell_keys",
        "missing_cell_keys",
        "remainder_cell_keys",
        "remainder_count",
        "verdict",
        "algorithm_ref_and_hash"
      ],
      "properties": {
        "required_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "pass_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "not_tested_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "failed_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "extra_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "missing_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "remainder_cell_keys": {"$ref": "#/$defs/cell_key_array"},
        "remainder_count": {"type": "integer", "minimum": 0},
        "verdict": {"enum": ["PASS", "BLOCKED"]},
        "algorithm_ref_and_hash": {"$ref": "#/$defs/ref_hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "not_tested_cell_keys": {"maxItems": 0},
              "failed_cell_keys": {"maxItems": 0},
              "extra_cell_keys": {"maxItems": 0},
              "missing_cell_keys": {"maxItems": 0},
              "remainder_cell_keys": {"maxItems": 0},
              "remainder_count": {"const": 0}
            }
          },
          "else": {"properties": {"remainder_cell_keys": {"minItems": 1}, "remainder_count": {"minimum": 1}}}
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signer_principal_id", "signature_encoding", "signature_b64", "signed_bytes_hash", "trust_root_hash", "issuer_key_registry_hash"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/exact_string"},
        "signer_principal_id": {"$ref": "#/$defs/exact_string"},
        "signature_encoding": {"const": "base64"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signed_bytes_hash": {"$ref": "#/$defs/hash"},
        "trust_root_hash": {"$ref": "#/$defs/hash"},
        "issuer_key_registry_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
