{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/work-package-dag/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "schema_ref",
    "dag_id",
    "dependency_semantics",
    "work_packages"
  ],
  "properties": {
    "schema_id": {"const": "seven/work-package-dag"},
    "schema_version": {"const": 1},
    "schema_ref": {"const": "work-package-dag.v1.schema.json"},
    "dag_id": {"type": "string", "minLength": 1},
    "dependency_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "activation"],
      "properties": {
        "development": {"type": "string", "minLength": 1},
        "activation": {"type": "string", "minLength": 1}
      }
    },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wp_id", "owner_type", "completion_contract", "development_dependencies", "activation_dependencies"],
        "properties": {
          "wp_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
          "owner_type": {"enum": ["IMPLEMENTER", "AUDITOR"]},
          "completion_contract": {"enum": ["DOC_BOOTSTRAP_RECORD", "IMPLEMENTATION_BUNDLE", "AUDIT_RECORD"]},
          "development_dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"}
          },
          "activation_dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"wp_id": {"const": "WP-DOC0"}}, "required": ["wp_id"]},
            "then": {"properties": {"owner_type": {"const": "IMPLEMENTER"}, "completion_contract": {"const": "DOC_BOOTSTRAP_RECORD"}}},
            "else": {"properties": {"completion_contract": {"not": {"const": "DOC_BOOTSTRAP_RECORD"}}}}
          },
          {
            "if": {"properties": {"owner_type": {"const": "AUDITOR"}}, "required": ["owner_type"]},
            "then": {"properties": {"completion_contract": {"const": "AUDIT_RECORD"}}},
            "else": {"properties": {"completion_contract": {"enum": ["DOC_BOOTSTRAP_RECORD", "IMPLEMENTATION_BUNDLE"]}}}
          },
          {
            "if": {"properties": {"completion_contract": {"const": "AUDIT_RECORD"}}, "required": ["completion_contract"]},
            "then": {"properties": {"owner_type": {"const": "AUDITOR"}}}
          }
        ]
      }
    }
  }
}
