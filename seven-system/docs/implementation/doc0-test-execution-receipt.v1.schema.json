{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/docs/doc0-test-execution-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "receipt_id",
    "wp_id",
    "implementation_subject",
    "checked_source_set_sha256",
    "normative_index_ref_and_hash",
    "work_package_plan_ref_and_hash",
    "dependency_lock_ref_and_hash",
    "schema_and_spec_refs_and_hashes",
    "commands",
    "aggregate_verdict",
    "side_effect_counts",
    "explicit_nonclaims",
    "created_at",
    "creator",
    "receipt_hash_algorithm",
    "receipt_hash"
  ],
  "properties": {
    "schema_id": {"const": "seven/docs/doc0-test-execution-receipt"},
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "wp_id": {"const": "WP-DOC0"},
    "implementation_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "working_tree_clean_before_tests", "source_relation"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "working_tree_clean_before_tests": {"const": true},
        "source_relation": {"const": "COMMITTED_TREE"}
      }
    },
    "checked_source_set_sha256": {"$ref": "#/$defs/hash"},
    "normative_index_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "work_package_plan_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "dependency_lock_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "schema_and_spec_refs_and_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref_hash"}, "uniqueItems": true},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "test_ids",
          "exact_argv",
          "cwd",
          "isolated_environment_summary",
          "started_at",
          "completed_at",
          "exit_code",
          "stdout_ref_and_hash",
          "stderr_ref_and_hash",
          "artifact_refs_and_hashes",
          "test_summary",
          "verdict"
        ],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DOC0-[A-Z0-9-]+$"}},
          "exact_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "isolated_environment_summary": {"type": "string", "minLength": 1},
          "started_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
          "completed_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
          "exit_code": {"type": "integer"},
          "stdout_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
          "stderr_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
          "artifact_refs_and_hashes": {"type": "array", "items": {"$ref": "#/$defs/ref_hash"}, "uniqueItems": true},
          "test_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["discovered", "executed", "passed", "failed", "skipped", "errors"],
            "properties": {
              "discovered": {"type": "integer", "minimum": 0},
              "executed": {"type": "integer", "minimum": 0},
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0},
              "errors": {"type": "integer", "minimum": 0}
            }
          },
          "verdict": {"enum": ["PASS", "FAIL"]}
        },
        "allOf": [
          {
            "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
            "then": {
              "properties": {
                "exit_code": {"const": 0},
                "test_summary": {
                  "properties": {
                    "discovered": {"minimum": 1},
                    "executed": {"minimum": 1},
                    "passed": {"minimum": 1},
                    "failed": {"const": 0},
                    "errors": {"const": 0}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "aggregate_verdict": {"enum": ["PASS", "FAIL"]},
    "side_effect_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db_connections", "db_writes", "redis_connections", "remote_model_calls", "target_solver_launches", "d_volume_writes"],
      "properties": {
        "db_connections": {"const": 0},
        "db_writes": {"const": 0},
        "redis_connections": {"const": 0},
        "remote_model_calls": {"const": 0},
        "target_solver_launches": {"const": 0},
        "d_volume_writes": {"const": 0}
      }
    },
    "explicit_nonclaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "creator": {"type": "string", "minLength": 1},
    "receipt_hash_algorithm": {"const": "sha256(canonical-json-with-receipt_hash-null)"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"aggregate_verdict": {"const": "PASS"}}, "required": ["aggregate_verdict"]},
      "then": {
        "properties": {
          "commands": {
            "items": {
              "properties": {
                "exit_code": {"const": 0},
                "verdict": {"const": "PASS"},
                "test_summary": {
                  "properties": {
                    "discovered": {"minimum": 1},
                    "executed": {"minimum": 1},
                    "passed": {"minimum": 1},
                    "failed": {"const": 0},
                    "errors": {"const": 0}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "ref_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
