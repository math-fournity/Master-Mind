{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/audit-readiness-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_id", "input_pack_ref_and_hash", "canonical_dag_ref_and_hash", "expected_scope", "expected_work_package_ids", "covered_work_package_ids", "missing_work_package_ids", "unexpected_work_package_ids", "invalid_work_package_ids", "audit_input_validation", "mechanical_handoff_status", "independent_audit_verdict", "state_effect", "claims", "nonclaims", "created_at", "creator", "report_hash_algorithm", "report_hash"],
  "properties": {
    "schema_id": {"const": "seven/audit-readiness-report"},
    "schema_version": {"const": 1},
    "report_id": {"type": "string", "minLength": 1},
    "input_pack_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "canonical_dag_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "expected_scope": {"enum": ["PACK_TARGETS_ONLY", "GA1_DEVELOPMENT_CLOSURE"]},
    "expected_work_package_ids": {"type": "array", "items": {"$ref": "#/$defs/wp_id"}, "uniqueItems": true},
    "covered_work_package_ids": {"type": "array", "items": {"$ref": "#/$defs/wp_id"}, "uniqueItems": true},
    "missing_work_package_ids": {"type": "array", "items": {"$ref": "#/$defs/wp_id"}, "uniqueItems": true},
    "unexpected_work_package_ids": {"type": "array", "items": {"$ref": "#/$defs/wp_id"}, "uniqueItems": true},
    "invalid_work_package_ids": {"type": "array", "items": {"$ref": "#/$defs/wp_id"}, "uniqueItems": true},
    "audit_input_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "errors"],
      "properties": {
        "verdict": {"enum": ["PASS", "FAIL"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mechanical_handoff_status": {"enum": ["COMPLETE", "INCOMPLETE", "INVALID_INPUT"]},
    "independent_audit_verdict": {"const": "NOT_STARTED"},
    "state_effect": {"const": "NONE"},
    "claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "creator": {"type": "string", "minLength": 1},
    "report_hash_algorithm": {"const": "sha256(canonical-json-with-report_hash-null)"},
    "report_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wp_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
    "ref_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
