{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seven/live-run-permit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "permit_id",
    "parent_authorization_id",
    "parent_authorization_ref_and_hash",
    "parent_authorization_signed_bytes_hash",
    "parent_subset_verification_contract_ref_and_hash",
    "authorization_mode",
    "wp_id",
    "epoch_id_if_any",
    "run_id_if_any",
    "action_units",
    "required_reservation_backend",
    "externally_pinned_trust_root",
    "actor_roster_ref_and_hash",
    "human_gate_policy_ref_and_hash",
    "signature_algorithm_registry_ref_and_hash",
    "revocation_policy_ref_and_hash",
    "issuer_actor_id",
    "issuer_key_id",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce",
    "canonicalizer_profile",
    "signature_domain",
    "signed_bytes_hash",
    "signature_envelope",
    "permit_hash_algorithm",
    "permit_hash"
  ],
  "properties": {
    "schema_id": {"const": "seven/live-run-permit"},
    "schema_version": {"const": 1},
    "permit_id": {"type": "string", "minLength": 1},
    "parent_authorization_id": {"type": "string", "minLength": 1},
    "parent_authorization_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "parent_authorization_signed_bytes_hash": {"$ref": "#/$defs/hash"},
    "parent_subset_verification_contract_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "authorization_mode": {"enum": ["AUDITED_ACTIVATION", "UNAUDITED_AUTHORIZED_CANARY", "TRUST_ROOT_OR_SCHEMA_BOOTSTRAP"]},
    "wp_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
    "epoch_id_if_any": {"type": ["string", "null"], "minLength": 1},
    "run_id_if_any": {"type": ["string", "null"], "minLength": 1},
    "action_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/action_unit"}},
    "required_reservation_backend": {"enum": ["DB_V2_OR_EQUIVALENT_TRANSACTIONAL_LEDGER", "SCHEMA_BOOTSTRAP_D_VOLUME_LEDGER"]},
    "externally_pinned_trust_root": {"$ref": "#/$defs/named_hash"},
    "actor_roster_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "human_gate_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "signature_algorithm_registry_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "revocation_policy_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
    "issuer_actor_id": {"type": "string", "minLength": 1},
    "issuer_key_id": {"type": "string", "minLength": 1},
    "issued_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "not_before": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "expires_at": {"$ref": "#/$defs/canonical_utc_timestamp"},
    "nonce": {"type": "string", "minLength": 16},
    "canonicalizer_profile": {"const": "RFC8785_JCS_UTF8"},
    "signature_domain": {"const": "seven-live-run-permit/v1\u0000"},
    "signed_bytes_hash": {"$ref": "#/$defs/hash"},
    "signature_envelope": {"$ref": "#/$defs/signature_envelope"},
    "permit_hash_algorithm": {"const": "sha256(RFC8785-JCS-object-with-permit_hash-null)"},
    "permit_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "ref_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "named_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "sha256"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "unit_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_invocations",
        "max_solver_launches",
        "max_database_writes",
        "max_redis_writes",
        "max_d_volume_writes",
        "max_human_gate_commits",
        "max_active_release_changes",
        "max_tokens",
        "max_cost_microunits",
        "currency"
      ],
      "properties": {
        "max_invocations": {"type": "integer", "minimum": 0},
        "max_solver_launches": {"type": "integer", "minimum": 0},
        "max_database_writes": {"type": "integer", "minimum": 0},
        "max_redis_writes": {"type": "integer", "minimum": 0},
        "max_d_volume_writes": {"type": "integer", "minimum": 0},
        "max_human_gate_commits": {"type": "integer", "minimum": 0},
        "max_active_release_changes": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_cost_microunits": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "anyOf": [
        {"properties": {"max_invocations": {"minimum": 1}}},
        {"properties": {"max_solver_launches": {"minimum": 1}}},
        {"properties": {"max_database_writes": {"minimum": 1}}},
        {"properties": {"max_redis_writes": {"minimum": 1}}},
        {"properties": {"max_d_volume_writes": {"minimum": 1}}},
        {"properties": {"max_human_gate_commits": {"minimum": 1}}},
        {"properties": {"max_active_release_changes": {"minimum": 1}}},
        {"properties": {"max_tokens": {"minimum": 1}}},
        {"properties": {"max_cost_microunits": {"minimum": 1}}}
      ]
    },
    "action_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumption_ordinal",
        "parent_action_scope_id",
        "parent_action_scope_hash",
        "action_kind",
        "authorization_action_registry_entry_ref_and_hash",
        "job_id",
        "attempt_id",
        "input_hash",
        "carrier_profile_or_solver_contract_hash_if_any",
        "target_binding_hash",
        "required_output_sink_and_acl_hash_if_any",
        "idempotency_key",
        "unit_budget"
      ],
      "properties": {
        "consumption_ordinal": {"type": "integer", "minimum": 0},
        "parent_action_scope_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "parent_action_scope_hash": {"$ref": "#/$defs/hash"},
        "action_kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "authorization_action_registry_entry_ref_and_hash": {"$ref": "#/$defs/ref_hash"},
        "job_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "input_hash": {"$ref": "#/$defs/hash"},
        "carrier_profile_or_solver_contract_hash_if_any": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "target_binding_hash": {"$ref": "#/$defs/hash"},
        "required_output_sink_and_acl_hash_if_any": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "idempotency_key": {"type": "string", "minLength": 16},
        "unit_budget": {"$ref": "#/$defs/unit_budget"}
      }
    },
    "signature_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signer_actor_id",
        "signature_encoding",
        "signature_b64",
        "signed_bytes_hash",
        "trust_root_hash",
        "actor_roster_hash",
        "policy_hash",
        "signature_algorithm_registry_hash"
      ],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "signer_actor_id": {"type": "string", "minLength": 1},
        "signature_encoding": {"const": "base64"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signed_bytes_hash": {"$ref": "#/$defs/hash"},
        "trust_root_hash": {"$ref": "#/$defs/hash"},
        "actor_roster_hash": {"$ref": "#/$defs/hash"},
        "policy_hash": {"$ref": "#/$defs/hash"},
        "signature_algorithm_registry_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
