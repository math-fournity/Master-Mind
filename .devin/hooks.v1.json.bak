{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 tools/moira_runtime.py hook SessionStart",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 tools/moira_runtime.py hook UserPromptSubmit",
          "timeout": 10
        }
      ]
    }
  ]
}
