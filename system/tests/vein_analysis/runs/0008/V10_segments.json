{
  "version": "V10",
  "phase": "grading",
  "problem": "IMO 2009 P6 - Grasshopper",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG排序 a₁ < a₂ < ... < aₙ（通过置换）——把一般情况归约到排序情况",
      "features": ["排序假设", "强归纳:统一框架"]
    },
    {
      "id": "段2",
      "content": "定义 x = a₁ + ... + a_{n-1}（除最大元素外所有元素之和）——引入关键变量x",
      "features": ["定义变量", "关键变量x:分类标准"]
    },
    {
      "id": "段3",
      "content": "对n做强归纳——建立统一证明框架",
      "features": ["归纳框架", "强归纳:统一框架"]
    },
    {
      "id": "段4",
      "content": "基于M的元素相对于x的位置分三种情况——建立情况分析框架",
      "features": ["情况分析", "关键变量x:分类标准"]
    },
    {
      "id": "段5",
      "content": "Case 1条件：x ∈ M 且 ∃ y ∈ M with y > x",
      "features": ["情况条件", "关键变量x:分类标准"]
    },
    {
      "id": "段6",
      "content": "由Case 1条件推出 n ≥ 3——推导规模约束",
      "features": ["推导约束"]
    },
    {
      "id": "段7",
      "content": "在n-1个小元素中定义'bad' index i：若 x - aᵢ ∈ M 或 s - aᵢ ∈ M 则i为bad——定义核心概念",
      "features": ["定义概念", "关键变量x:bad index基准", "bad index:Case1工具"]
    },
    {
      "id": "段8",
      "content": "bad indices到M\\{x}的映射是单射——建立单射论证的主命题",
      "features": ["单射论证", "bad index:Case1工具"]
    },
    {
      "id": "段9",
      "content": "x - aᵢ 映射到 M\\{x}（因为 x ∈ M 且 aᵢ > 0，故 x - aᵢ < x）——单射论证细节1",
      "features": ["单射论证细节", "关键变量x:bad index基准"]
    },
    {
      "id": "段10",
      "content": "s - aᵢ > x 所以映射到 M∩(x,∞)——单射论证细节2，两类bad index映射到M的不同部分",
      "features": ["单射论证细节", "s:最终和验证"]
    },
    {
      "id": "段11",
      "content": "|M\\{x}| = n-2，所以n-1个元素中至多n-2个bad——计数论证得出bad index上界",
      "features": ["计数论证"]
    },
    {
      "id": "段12",
      "content": "至少存在一个good index r，满足 x - aᵣ ∉ M 且 s - aᵣ ∉ M——由计数得出存在性",
      "features": ["存在性论证", "bad index:Case1工具"]
    },
    {
      "id": "段13",
      "content": "令 t = x - aᵣ，M' = M ∩ (-∞, t]——定义缩减问题和缩减集",
      "features": ["定义缩减问题", "关键变量x:M'缩减边界", "M':递归核心"]
    },
    {
      "id": "段14",
      "content": "|M'| ≤ n-3（因为x和y都被排除在M'之外）——计数缩减集大小",
      "features": ["计数论证", "M':递归核心"]
    },
    {
      "id": "段15",
      "content": "对n-2个剩余元素（排除aᵣ和aₙ）用M'做归纳——递归调用，规模从n降到n-2",
      "features": ["递归调用", "强归纳:统一框架", "M':递归核心"]
    },
    {
      "id": "段16",
      "content": "构造完整置换：p'在前，然后aᵣ，然后aₙ（通过swap把aₙ放倒数第二位）——构造解",
      "features": ["构造解", "swap技巧:跨Case复用", "最大元素aₙ:跳过障碍"]
    },
    {
      "id": "段17",
      "content": "验证：aᵣ之前的所有前缀和 ≤ t 且避开M'——验证前缀部分",
      "features": ["验证", "关键变量x:M'缩减边界"]
    },
    {
      "id": "段18",
      "content": "验证：到aᵣ的和 = s - aₙ 避开M（由r的选择保证）——验证中间跳跃",
      "features": ["验证"]
    },
    {
      "id": "段19",
      "content": "验证：最终和为s ∉ M——验证终点",
      "features": ["验证", "s:最终和验证"]
    },
    {
      "id": "段20",
      "content": "Case 2条件：x ∉ M 且 ∃ y ∈ M with y > x",
      "features": ["情况条件", "关键变量x:分类标准"]
    },
    {
      "id": "段21",
      "content": "|M ∩ (-∞, x]| ≤ n-2——计数M在x以下的部分",
      "features": ["计数论证"]
    },
    {
      "id": "段22",
      "content": "令 M' = M ∩ (-∞, x]——定义缩减问题",
      "features": ["定义缩减问题", "关键变量x:M'缩减边界", "M':递归核心"]
    },
    {
      "id": "段23",
      "content": "对a₁,...,a_{n-1}用M'做归纳（和为x ∉ M'）——递归调用",
      "features": ["递归调用", "强归纳:统一框架", "M':递归核心"]
    },
    {
      "id": "段24",
      "content": "若M'为空，直接用恒等置换——处理边界情况",
      "features": ["边界情况"]
    },
    {
      "id": "段25",
      "content": "扩展置换：把aₙ放在最后——构造完整解",
      "features": ["构造解", "最大元素aₙ:跳过障碍"]
    },
    {
      "id": "段26",
      "content": "验证：前n-1跳的前缀和 ≤ x 且避开M'——验证前缀部分",
      "features": ["验证", "关键变量x:M'缩减边界"]
    },
    {
      "id": "段27",
      "content": "验证：最终和为s ∉ M——验证终点",
      "features": ["验证", "s:最终和验证"]
    },
    {
      "id": "段28",
      "content": "Case 3条件：所有 m ∈ M 满足 m ≤ x",
      "features": ["情况条件", "关键变量x:分类标准"]
    },
    {
      "id": "段29",
      "content": "令 z = max(M)，M' = M\\{z}——定义缩减问题，剥离最大障碍点",
      "features": ["定义缩减问题", "M':递归核心"]
    },
    {
      "id": "段30",
      "content": "对a₁,...,a_{n-1}用M'做归纳（|M'| = n-2）——递归调用",
      "features": ["递归调用", "强归纳:统一框架", "M':递归核心"]
    },
    {
      "id": "段31",
      "content": "得到置换p'——获得递归解",
      "features": ["构造解"]
    },
    {
      "id": "段32",
      "content": "若p'某前缀和在位置k等于z，swap位置k和最后位置——应用swap技巧修正",
      "features": ["swap技巧:跨Case复用"]
    },
    {
      "id": "段33",
      "content": "把aₙ放位置k（因aₙ > a_{p'(k)}跳过z），a_{p'(k)}放最后——swap细节，利用最大元素跳过障碍",
      "features": ["swap技巧:跨Case复用", "最大元素aₙ:跳过障碍"]
    },
    {
      "id": "段34",
      "content": "若无前缀和等于z，p'已避开所有M（M = M' ∪ {z}且z未被命中）——无需swap的情况",
      "features": ["验证"]
    },
    {
      "id": "段35",
      "content": "一般情况（未排序a）通过复合排序置换归约到排序情况——完成归约",
      "features": ["归约"]
    }
  ]
}
