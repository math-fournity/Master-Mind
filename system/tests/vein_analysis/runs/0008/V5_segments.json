{
  "version": "V5",
  "phase": "grading",
  "problem": "IMO 2009 P6 (grasshopper)",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG排序 a₁ < a₂ < ... < aₙ（通过施加一个排列）",
      "features": ["归一化", "排序", "对称性利用"]
    },
    {
      "id": "段2",
      "content": "定义 x = a₁ + ... + a_{n-1}（除最大元外所有元素之和）",
      "features": ["定义变量", "关键量提取"]
    },
    {
      "id": "段3",
      "content": "声明对 n 用强归纳",
      "features": ["强归纳策略", "证明框架声明"]
    },
    {
      "id": "段4",
      "content": "按 M 中元素相对 x 的位置分三种情况",
      "features": ["情况划分", "分类标准设立"]
    },
    {
      "id": "段5",
      "content": "Case 1 条件：x ∈ M 且存在 y ∈ M 满足 y > x",
      "features": ["情况条件"]
    },
    {
      "id": "段6",
      "content": "由 Case 1 条件推断 n ≥ 3",
      "features": ["边界推断"]
    },
    {
      "id": "段7",
      "content": "在前 n-1 个小元素中定义'bad'指标 i：x - aᵢ ∈ M 或 s - aᵢ ∈ M",
      "features": ["定义变量", "坏指标概念", "反面刻画"]
    },
    {
      "id": "段8",
      "content": "论证从 bad 指标到 M\\{x} 的映射是单射（x - aᵢ 因 x ∈ M 且 aᵢ > 0 落入 M\\{x}；s - aᵢ > x 落入 M∩(x,∞)）",
      "features": ["鸽巢论证", "注入性论证", "映射构造"]
    },
    {
      "id": "段9",
      "content": "由 |M\\{x}| = n-2 得 bad 指标至多 n-2 个，n-1 个中至少存在一个 good 指标 r",
      "features": ["计数论证", "存在性论证", "鸽巢论证"]
    },
    {
      "id": "段10",
      "content": "令 t = x - aᵣ，M' = M ∩ (-∞, t]",
      "features": ["定义变量", "子问题构造"]
    },
    {
      "id": "段11",
      "content": "由 x 和 y 均被排除得 |M'| ≤ n-3",
      "features": ["计数论证", "规模估计"]
    },
    {
      "id": "段12",
      "content": "对剩余 n-2 个元素（去掉 aᵣ 和 aₙ）以 M' 应用归纳，得排列 p'",
      "features": ["归纳应用", "规模缩减"]
    },
    {
      "id": "段13",
      "content": "构造完整排列：p' 在前，aᵣ 次之，aₙ 最后（并做一次交换把 aₙ 放到倒数第二位）",
      "features": ["构造", "排列拼接", "交换技巧"]
    },
    {
      "id": "段14",
      "content": "验证：aᵣ 之前所有前缀和 ≤ t 且避开 M'；到 aᵣ 的和避开 M（由 r 的选取）；最终和为 s ∉ M",
      "features": ["验证", "前缀和分析", "构造正确性论证"]
    },
    {
      "id": "段15",
      "content": "Case 2 条件：x ∉ M 且存在 y ∈ M 满足 y > x",
      "features": ["情况条件"]
    },
    {
      "id": "段16",
      "content": "由 Case 2 条件得 |M ∩ (-∞, x]| ≤ n-2",
      "features": ["计数论证", "规模估计"]
    },
    {
      "id": "段17",
      "content": "令 M' = M ∩ (-∞, x]，其和为 x ∉ M'",
      "features": ["定义变量", "子问题构造"]
    },
    {
      "id": "段18",
      "content": "对 a₁,...,a_{n-1} 以 M' 应用归纳，得排列 p'（M' 为空时直接用恒等排列）",
      "features": ["归纳应用", "规模缩减", "边界情况处理"]
    },
    {
      "id": "段19",
      "content": "将 a₨ 放在最后扩展 p' 为完整排列",
      "features": ["构造", "排列拼接"]
    },
    {
      "id": "段20",
      "content": "验证：前 n-1 次跳跃的前缀和 ≤ x 且避开 M'；最终和为 s ∉ M",
      "features": ["验证", "前缀和分析", "构造正确性论证"]
    },
    {
      "id": "段21",
      "content": "Case 3 条件：所有 m ∈ M 满足 m ≤ x",
      "features": ["情况条件"]
    },
    {
      "id": "段22",
      "content": "令 z = max(M)，M' = M\\{z}",
      "features": ["定义变量", "子问题构造", "极值选取"]
    },
    {
      "id": "段23",
      "content": "对 a₁,...,a_{n-1} 以 M'（|M'| = n-2）应用归纳，得排列 p'",
      "features": ["归纳应用", "规模缩减"]
    },
    {
      "id": "段24",
      "content": "情况 A：若 p' 的某前缀和在位置 k 等于 z，则把 aₙ 放到位置 k（因 aₙ > a_{p'(k)} 跳过 z），原 a_{p'(k)} 放最后",
      "features": ["情况分析", "构造", "交换技巧", "跳越障碍"]
    },
    {
      "id": "段25",
      "content": "情况 B：若无前缀和等于 z，则 p' 已避开 M（M = M' ∪ {z} 且 z 从未被命中）",
      "features": ["验证", "平凡情况", "构造正确性论证"]
    },
    {
      "id": "段26",
      "content": "一般（未排序）情况通过复合排序排列归约到已排序情况",
      "features": ["归约", "归一化合成", "对称性利用"]
    }
  ]
}
