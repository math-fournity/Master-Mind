{
  "version": "V10",
  "phase": "grading",
  "problem": "IMO2009 P6 (grasshopper)",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG通过施加置换把a排序为a₁<a₂<...<aₙ",
      "features": ["归约(WLOG)", "排序"]
    },
    {
      "id": "段2",
      "content": "定义x=a₁+...+a_{n-1}（除最大元aₙ外所有元素之和）",
      "features": ["定义变量", "实体x:子问题和", "实体aₙ:放最后"]
    },
    {
      "id": "段3",
      "content": "确立强归纳框架：对n做强归纳",
      "features": ["归纳框架", "强归纳", "实体强归纳:框架"]
    },
    {
      "id": "段4",
      "content": "按M中元素相对x的位置把问题分成三种情况",
      "features": ["情况划分", "实体x:分类标准"]
    },
    {
      "id": "段5",
      "content": "Case 1条件：x∈M且∃y∈M,y>x；由此推出n≥3",
      "features": ["Case条件", "边界条件", "实体x:分类标准"]
    },
    {
      "id": "段6",
      "content": "在n-1个小元素中定义bad index i：x-aᵢ∈M或s-aᵢ∈M",
      "features": ["定义概念", "实体bad-index:核心概念", "实体x:缩减边界"]
    },
    {
      "id": "段7",
      "content": "构造bad index到M\\{x}的注入映射（x-aᵢ映到M\\{x}因x∈M且aᵢ>0；s-aᵢ>x映到M∩(x,∞)）",
      "features": ["注入论证", "映射构造", "实体bad-index:核心概念", "实体x:分类标准"]
    },
    {
      "id": "段8",
      "content": "计数论证：|M\\{x}|=n-2，故至多n-2个bad，n-1个中至少存在一个好index r",
      "features": ["计数论证", "鸽巢", "存在性论证", "实体bad-index:核心概念"]
    },
    {
      "id": "段9",
      "content": "定义t=x-aᵣ，构造M'=M∩(-∞,t]",
      "features": ["定义变量", "M'缩减构造", "实体t:缩减边界", "实体M':子问题M", "实体x:缩减边界"]
    },
    {
      "id": "段10",
      "content": "估计|M'|≤n-3（x和y都被排除在M'之外）",
      "features": ["基数估计", "实体M':子问题M", "实体t:缩减边界"]
    },
    {
      "id": "段11",
      "content": "对去掉aᵣ和aₙ后的n-2个剩余元素用归纳假设于M'，得排列p'",
      "features": ["归纳应用", "子问题构造", "实体强归纳:框架", "实体M':子问题M", "实体aₙ:放最后"]
    },
    {
      "id": "段12",
      "content": "构造完整排列：p'在前，然后aᵣ，然后aₙ（用swap把aₙ放到倒数第二位）",
      "features": ["排列构造", "swap技巧", "实体swap:跨Case复用", "实体aₙ:放最后", "实体aₙ:跳过障碍"]
    },
    {
      "id": "段13",
      "content": "验证Case 1：aᵣ前的前缀和≤t避M'；到aᵣ的和=s-aₙ避M（由r的选取）；最终和s∉M",
      "features": ["验证", "前缀和分析", "实体t:缩减边界", "实体M':子问题M", "实体前缀和验证:跨Case验证"]
    },
    {
      "id": "段14",
      "content": "Case 2条件：x∉M且∃y∈M,y>x；故|M∩(-∞,x]|≤n-2",
      "features": ["Case条件", "基数估计", "实体x:分类标准", "实体x:缩减边界"]
    },
    {
      "id": "段15",
      "content": "构造M'=M∩(-∞,x]",
      "features": ["M'缩减构造", "实体M':子问题M", "实体x:缩减边界"]
    },
    {
      "id": "段16",
      "content": "对a₁,...,a_{n-1}用归纳假设于M'（其和为x∉M'）",
      "features": ["归纳应用", "子问题构造", "实体强归纳:框架", "实体M':子问题M", "实体x:子问题和"]
    },
    {
      "id": "段17",
      "content": "退化处理：若M'为空，直接用恒等排列",
      "features": ["退化情况", "排列构造", "实体M':子问题M"]
    },
    {
      "id": "段18",
      "content": "否则取归纳得到的p'，把aₙ放在最后扩展排列",
      "features": ["排列构造", "实体aₙ:放最后"]
    },
    {
      "id": "段19",
      "content": "验证Case 2：前n-1个前缀和≤x避M'；最终和s∉M",
      "features": ["验证", "前缀和分析", "实体M':子问题M", "实体x:缩减边界", "实体前缀和验证:跨Case验证", "实体aₙ:放最后"]
    },
    {
      "id": "段20",
      "content": "Case 3条件：所有m∈M满足m≤x",
      "features": ["Case条件", "实体x:分类标准"]
    },
    {
      "id": "段21",
      "content": "令z=max(M)，构造M'=M\\{z}",
      "features": ["定义变量", "M'缩减构造", "实体z:跳过目标", "实体M':子问题M"]
    },
    {
      "id": "段22",
      "content": "对a₁,...,a_{n-1}用归纳假设于M'（|M'|=n-2），得排列p'",
      "features": ["归纳应用", "子问题构造", "排列构造", "实体强归纳:框架", "实体M':子问题M"]
    },
    {
      "id": "段23",
      "content": "若p'某前缀和在位置k等于z，swap位置k与最后：aₙ放位置k（因aₙ>a_{p'(k)}跳过z），a_{p'(k)}放最后",
      "features": ["swap技巧", "跳过障碍", "排列构造", "实体swap:跨Case复用", "实体z:跳过目标", "实体aₙ:跳过障碍", "实体前缀和验证:跨Case验证"]
    },
    {
      "id": "段24",
      "content": "若无前缀和等于z，则p'已避开M=M'∪{z}（z从未被命中）",
      "features": ["验证", "退化情况", "实体z:跳过目标", "实体前缀和验证:跨Case验证"]
    },
    {
      "id": "段25",
      "content": "一般情况（未排序的a）通过复合排序置换归约到已排序情况",
      "features": ["归约(收口)", "排序"]
    }
  ]
}
