{
  "version": "V8",
  "phase": "grading",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG将a₁,...,aₙ排序为a₁<a₂<...<aₙ（通过施加一个排列）",
      "features": ["WLOG排序", "排列复合"]
    },
    {
      "id": "段2",
      "content": "定义x = a₁+...+a_{n-1}（除最大元aₙ外所有元素之和）",
      "features": ["定义关键变量x", "aₙ的最大性"]
    },
    {
      "id": "段3",
      "content": "对n施加强归纳",
      "features": ["强归纳假设"]
    },
    {
      "id": "段4",
      "content": "根据M中元素相对于x的位置分三种情况",
      "features": ["情况划分", "x的分界角色"]
    },
    {
      "id": "段5",
      "content": "Case 1条件：x∈M且存在y∈M使y>x，此时n≥3",
      "features": ["Case1条件", "x∈M", "x的分界角色"]
    },
    {
      "id": "段6",
      "content": "在n-1个小元素中定义'bad'下标i：若x-aᵢ∈M或s-aᵢ∈M则i为bad",
      "features": ["定义bad-index", "x的使用", "s-aᵢ的角色"]
    },
    {
      "id": "段7",
      "content": "证明bad下标到M\\{x}的映射是单射（x-aᵢ映到M\\{x}因为x∈M且aᵢ>0；s-aᵢ>x所以映到M∩(x,∞)）",
      "features": ["单射论证", "鸽巢原理", "x∈M", "x的使用"]
    },
    {
      "id": "段8",
      "content": "计数论证：|M\\{x}|=n-2，所以n-1个下标中至多n-2个bad，至少存在一个good下标r使x-aᵣ∉M且s-aᵣ∉M",
      "features": ["计数论证", "good-index存在性", "aᵣ的选择", "s-aᵢ的角色"]
    },
    {
      "id": "段9",
      "content": "定义t=x-aᵣ，M'=M∩(-∞,t]",
      "features": ["定义子问题参数t", "定义子问题M'", "aᵣ的选择", "x的使用"]
    },
    {
      "id": "段10",
      "content": "论证|M'|≤n-3（因为x和y都被排除在M'之外）",
      "features": ["子问题规模论证", "x∈M"]
    },
    {
      "id": "段11",
      "content": "对去掉aᵣ和aₙ后的n-2个元素用M'应用归纳假设，得到排列p'",
      "features": ["应用归纳假设", "子问题构造", "aᵣ的选择", "aₙ的最大性"]
    },
    {
      "id": "段12",
      "content": "构造完整排列：先放p'，然后aᵣ，然后aₙ（通过swap把aₙ放到倒数第二位）",
      "features": ["构造完整排列", "swap技巧", "aₙ的最大性"]
    },
    {
      "id": "段13",
      "content": "验证：aᵣ之前的所有前缀和≤t且避开M'",
      "features": ["前缀和验证", "避开M'"]
    },
    {
      "id": "段14",
      "content": "验证：到aᵣ处的和为s-aₙ=s-aᵣ-(其余之和)，由r的选择避开M",
      "features": ["前缀和验证", "避开M", "aᵣ的选择", "s-aᵢ的角色"]
    },
    {
      "id": "段15",
      "content": "验证：最终和为s∉M",
      "features": ["最终和验证", "s∉M"]
    },
    {
      "id": "段16",
      "content": "Case 2条件：x∉M且存在y∈M使y>x",
      "features": ["Case2条件", "x∉M", "x的分界角色"]
    },
    {
      "id": "段17",
      "content": "论证|M∩(-∞,x]|≤n-2",
      "features": ["子问题规模论证", "x的使用"]
    },
    {
      "id": "段18",
      "content": "定义M'=M∩(-∞,x]",
      "features": ["定义子问题M'", "x的使用"]
    },
    {
      "id": "段19",
      "content": "对a₁,...,a_{n-1}用M'应用归纳假设（其和为x∉M'）",
      "features": ["应用归纳假设", "子问题构造", "x∉M"]
    },
    {
      "id": "段20",
      "content": "若M'为空，直接用恒等排列",
      "features": ["空集边界处理", "恒等排列", "条件分支"]
    },
    {
      "id": "段21",
      "content": "否则得到排列p'，将aₙ放在最后扩展",
      "features": ["构造完整排列", "aₙ的最大性", "条件分支"]
    },
    {
      "id": "段22",
      "content": "验证：前n-1跳的所有前缀和≤x且避开M'",
      "features": ["前缀和验证", "避开M'", "x的使用"]
    },
    {
      "id": "段23",
      "content": "验证：最终和为s∉M",
      "features": ["最终和验证", "s∉M"]
    },
    {
      "id": "段24",
      "content": "Case 3条件：所有m∈M都满足m≤x",
      "features": ["Case3条件", "x的分界角色"]
    },
    {
      "id": "段25",
      "content": "定义z=max(M)，M'=M\\{z}",
      "features": ["定义z=max(M)", "定义子问题M'"]
    },
    {
      "id": "段26",
      "content": "对a₁,...,a_{n-1}用M'应用归纳假设（|M'|=n-2），得到排列p'",
      "features": ["应用归纳假设", "子问题构造"]
    },
    {
      "id": "段27",
      "content": "若p'的某个前缀和在位置k处等于z，则交换位置k与最后位置：在位置k放aₙ（因aₙ>a_{p'(k)}跳过z），将a_{p'(k)}放最后",
      "features": ["swap技巧", "aₙ的最大性", "跳过z", "条件分支", "构造完整排列"]
    },
    {
      "id": "段28",
      "content": "若没有前缀和等于z，则p'已避开全部M（因为M=M'∪{z}而z从未被命中）",
      "features": ["条件分支", "避开M", "定义z=max(M)"]
    },
    {
      "id": "段29",
      "content": "一般情况（未排序的a）通过与排序排列复合归约为已排序情况",
      "features": ["一般情况归约", "排列复合"]
    }
  ]
}
