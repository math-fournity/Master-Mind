{
  "version": "V8",
  "phase": "grading",
  "step": 1,
  "segments": [
    {
      "id": "段1",
      "content": "WLOG将a₁<a₂<...<aₙ排序（通过应用一个置换）",
      "features": ["WLOG归约", "排序", "aₙ的最大性"]
    },
    {
      "id": "段2",
      "content": "定义x为前n-1个元素之和（除最大元外所有元素的和）",
      "features": ["定义变量", "x的定义", "aₙ的最大性"]
    },
    {
      "id": "段3",
      "content": "对n进行强归纳",
      "features": ["强归纳假设"]
    },
    {
      "id": "段4",
      "content": "根据M中元素相对于x的位置分三种情况",
      "features": ["情况分析", "x作为情况划分标准"]
    },
    {
      "id": "段5",
      "content": "Case 1前提：x∈M且存在y∈M使y>x，则n≥3",
      "features": ["情况前提", "x作为情况划分标准"]
    },
    {
      "id": "段6",
      "content": "在前n-1个小元素中定义bad下标i：x-aᵢ∈M或s-aᵢ∈M",
      "features": ["定义变量", "aᵣ的候选定义", "x作为情况划分标准"]
    },
    {
      "id": "段7",
      "content": "bad下标到M\\{x}的映射是单射（x-aᵢ映射到M\\{x}因为x∈M且aᵢ>0；s-aᵢ>x所以映射到M∩(x,∞)）",
      "features": ["单射论证", "aᵣ的候选定义", "x作为情况划分标准"]
    },
    {
      "id": "段8",
      "content": "由于|M\\{x}|=n-2，n-1个下标中最多n-2个bad，所以至少存在一个good下标r使x-aᵣ∉M且s-aᵣ∉M",
      "features": ["鸽巢论证", "aᵣ的存在性证明", "aₙ的最大性"]
    },
    {
      "id": "段9",
      "content": "令t=x-aᵣ，M'=M∩(-∞,t]，则|M'|≤n-3（因为x和y都被排除）",
      "features": ["定义子问题", "M'的构造", "aᵣ的存在性证明", "x作为前缀和上界"]
    },
    {
      "id": "段10",
      "content": "对剩余n-2个元素（排除aᵣ和aₙ）用M'归纳，得到置换p'",
      "features": ["归纳应用", "M'作为归纳子问题", "aₙ的最大性", "aᵣ的存在性证明"]
    },
    {
      "id": "段11",
      "content": "构造完整置换：先放p'，再放aᵣ，再放aₙ（交换使aₙ放倒数第二）",
      "features": ["构造性证明", "swap技巧", "aₙ放最后角色", "aᵣ的存在性证明"]
    },
    {
      "id": "段12",
      "content": "验证Case1构造：aᵣ之前的所有前缀和≤t且避开M'；到aᵣ的和为s-aₙ避开M（由r的选择）；最终和为s∉M",
      "features": ["验证构造", "M'作为归纳子问题", "aᵣ的存在性证明", "x作为前缀和上界", "aₙ放最后角色"]
    },
    {
      "id": "段13",
      "content": "Case 2前提：x∉M且存在y∈M使y>x，则|M∩(-∞,x]|≤n-2",
      "features": ["情况前提", "x作为情况划分标准", "M'的构造"]
    },
    {
      "id": "段14",
      "content": "令M'=M∩(-∞,x]，对a₁,...,a_{n-1}用M'归纳（和为x∉M'）",
      "features": ["定义子问题", "归纳应用", "M'作为归纳子问题", "x作为前缀和上界", "aₙ的最大性"]
    },
    {
      "id": "段15",
      "content": "若M'为空用恒等置换；否则得置换p'，最后放aₙ",
      "features": ["构造性证明", "aₙ放最后角色", "M'作为归纳子问题"]
    },
    {
      "id": "段16",
      "content": "验证Case2构造：前n-1跳的所有前缀和≤x且避开M'；最终和为s∉M",
      "features": ["验证构造", "M'作为归纳子问题", "x作为前缀和上界", "aₙ放最后角色"]
    },
    {
      "id": "段17",
      "content": "Case 3前提：所有m∈M满足m≤x。令z=max(M)，M'=M\\{z}",
      "features": ["定义子问题", "M'的构造", "x作为情况划分标准"]
    },
    {
      "id": "段18",
      "content": "对a₁,...,a_{n-1}用M'归纳（|M'|=n-2），得置换p'",
      "features": ["归纳应用", "M'作为归纳子问题", "aₙ的最大性"]
    },
    {
      "id": "段19",
      "content": "若p'某前缀和在位置k等于z，交换位置k与最后位置：aₙ放位置k（因aₙ>a_{p'(k)}跳过z），a_{p'(k)}放最后",
      "features": ["构造性证明", "swap技巧", "aₙ的最大性", "M'作为归纳子问题"]
    },
    {
      "id": "段20",
      "content": "若无前缀和等于z，p'已避开M所有元素（M=M'∪{z}且z不被命中）",
      "features": ["情况分析", "M'作为归纳子问题"]
    },
    {
      "id": "段21",
      "content": "一般情况（未排序的a）通过复合排序置换归约为已排序情况",
      "features": ["WLOG归约", "排序"]
    }
  ]
}
