{
  "version": "V10",
  "phase": "grading",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG排序a₁<a₂<...<aₙ（通过施加一个置换），将问题归约到已排序情形",
      "features": ["排序归约", "WLOG假设", "一般情况归约"]
    },
    {
      "id": "段2",
      "content": "定义x = a₁+...+a_{n-1}（除最大元素外所有元素之和），引入核心边界量",
      "features": ["定义关键变量", "边界量构造", "实体:x", "实体:aₙ"]
    },
    {
      "id": "段3",
      "content": "确立对n做强归纳的证明框架",
      "features": ["归纳框架确立", "实体:强归纳"]
    },
    {
      "id": "段4",
      "content": "根据M中元素相对于x的位置分三种情况——以x为分类标准",
      "features": ["情况分析", "分类标准(x)", "实体:x"]
    },
    {
      "id": "段5",
      "content": "Case 1条件设定：x∈M且存在y∈M使y>x，推出n≥3",
      "features": ["Case条件设定", "分类标准(x)", "实体:x"]
    },
    {
      "id": "段6",
      "content": "在n-1个小元素中定义'bad'指标i：当x-aᵢ∈M或s-aᵢ∈M时i为坏指标",
      "features": ["定义辅助概念", "实体:bad index", "实体:x"]
    },
    {
      "id": "段7",
      "content": "构造从bad指标到M\\{x}的注入映射（x-aᵢ映到M\\{x}因为x∈M且aᵢ>0；s-aᵢ>x映到M∩(x,∞)），论证注入性",
      "features": ["注入性论证", "映射构造", "实体:bad index", "实体:x"]
    },
    {
      "id": "段8",
      "content": "由|M\\{x}|=n-2，n-1个指标中至多n-2个bad，故至少存在一个好指标r（x-aᵣ∉M且s-aᵣ∉M）——鸽巢/计数论证得到存在性",
      "features": ["鸽巢论证", "存在性论证", "实体:bad index"]
    },
    {
      "id": "段9",
      "content": "令t=x-aᵣ，M'=M∩(-∞,t]，则|M'|≤n-3（x和y都被排除）——定义新边界量t并缩减M",
      "features": ["定义关键变量", "边界量构造", "实体:M'缩减", "实体:x"]
    },
    {
      "id": "段10",
      "content": "对去掉aᵣ和aₙ后的n-2个元素用M'应用归纳假设，得到排列p'",
      "features": ["应用归纳假设", "实体:强归纳", "实体:M'缩减"]
    },
    {
      "id": "段11",
      "content": "构造完整排列：p'在前，然后aᵣ，然后aₙ（用swap把aₙ放到倒数第二位）——swap技巧构造",
      "features": ["构造排列", "实体:swap技巧", "实体:aₙ"]
    },
    {
      "id": "段12",
      "content": "验证避开M：aᵣ之前所有前缀和≤t且避开M'；到aᵣ的和为s-aₙ=x避开M（由r的选择）；最终和为s∉M",
      "features": ["验证避开M", "前缀和分析", "实体:x", "实体:aₙ"]
    },
    {
      "id": "段13",
      "content": "Case 2条件设定：x∉M且存在y∈M使y>x，则|M∩(-∞,x]|≤n-2",
      "features": ["Case条件设定", "分类标准(x)", "实体:x"]
    },
    {
      "id": "段14",
      "content": "令M'=M∩(-∞,x]，对a₁,...,a_{n-1}用M'应用归纳假设（和为x∉M'）",
      "features": ["应用归纳假设", "实体:强归纳", "实体:M'缩减", "实体:x"]
    },
    {
      "id": "段15",
      "content": "若M'为空用恒等排列，否则取排列p'并在末尾放aₙ——构造排列并处理边界情况",
      "features": ["构造排列", "边界情况处理", "实体:aₙ"]
    },
    {
      "id": "段16",
      "content": "验证避开M：前n-1跳的前缀和≤x且避开M'；最终和为s∉M",
      "features": ["验证避开M", "前缀和分析", "实体:x"]
    },
    {
      "id": "段17",
      "content": "Case 3条件设定：所有m∈M满足m≤x。令z=max(M)，M'=M\\{z}——定义z并缩减M",
      "features": ["Case条件设定", "定义关键变量", "实体:M'缩减", "实体:z", "实体:x"]
    },
    {
      "id": "段18",
      "content": "对a₁,...,a_{n-1}用M'应用归纳假设（|M'|=n-2），得到排列p'",
      "features": ["应用归纳假设", "实体:强归纳", "实体:M'缩减"]
    },
    {
      "id": "段19",
      "content": "若p'某前缀和在位置k处等于z，swap位置k与末位：aₙ放位置k（因aₙ>a_{p'(k)}跳过z），a_{p'(k)}放末位——swap技巧跳过障碍z",
      "features": ["构造排列", "跳过障碍", "实体:swap技巧", "实体:aₙ", "实体:z"]
    },
    {
      "id": "段20",
      "content": "若无前缀和等于z，p'已避开全部M（M=M'∪{z}而z永不被命中）——平凡情况处理",
      "features": ["平凡情况处理", "验证避开M", "实体:z"]
    },
    {
      "id": "段21",
      "content": "一般情形（未排序a）通过复合排序置换归约到已排序情形",
      "features": ["一般情况归约", "排序归约"]
    }
  ]
}
