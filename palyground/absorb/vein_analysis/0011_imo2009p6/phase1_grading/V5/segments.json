{
  "version": "V5",
  "phase": "grading",
  "problem_id": "0011_imo2009p6",
  "segments": [
    {
      "id": "段1",
      "content": "WLOG通过排列将a₁<a₂<...<aₙ排序假设建立起来",
      "features": ["WLOG归约", "排序"]
    },
    {
      "id": "段2",
      "content": "定义辅助量x为前n-1个元素之和（除最大元aₙ外）",
      "features": ["辅助量定义"]
    },
    {
      "id": "段3",
      "content": "声明对n做强归纳作为整体证明策略",
      "features": ["强归纳策略", "归纳声明"]
    },
    {
      "id": "段4",
      "content": "根据M中元素相对x的位置分三种情形（x∈M与否、是否存在y>x）",
      "features": ["分类框架", "情况划分"]
    },
    {
      "id": "段5",
      "content": "Case 1：由x∈M且∃y∈M,y>x推出n≥3",
      "features": ["必要性推导"]
    },
    {
      "id": "段6",
      "content": "Case 1：定义'坏'指标i——若x-aᵢ∈M或s-aᵢ∈M则i为坏",
      "features": ["反定义", "坏指标定义"]
    },
    {
      "id": "段7",
      "content": "Case 1：证明从坏指标到M\\{x}的映射是注入的（x-aᵢ因x∈M且aᵢ>0落入M\\{x}；s-aᵢ>x落入M∩(x,∞)）",
      "features": ["注入性论证", "映射构造"]
    },
    {
      "id": "段8",
      "content": "Case 1：由|M\\{x}|=n-2知n-1个指标中至多n-2个坏，故存在good指标r",
      "features": ["鸽巢论证", "计数论证", "存在性论证"]
    },
    {
      "id": "段9",
      "content": "Case 1：令t=x-aᵣ，构造子问题禁地M'=M∩(-∞,t]",
      "features": ["子问题构造", "截断集合构造"]
    },
    {
      "id": "段10",
      "content": "Case 1：估计|M'|≤n-3（x和y都被排除在M'之外）",
      "features": ["规模估计"]
    },
    {
      "id": "段11",
      "content": "Case 1：对去掉aᵣ和aₙ后的n-2个元素与M'应用归纳假设，得排列p'",
      "features": ["归纳应用"]
    },
    {
      "id": "段12",
      "content": "Case 1：拼接完整排列——p'在前，然后aᵣ，然后aₙ（通过交换使aₙ位于倒数第二）",
      "features": ["排列拼接构造", "构造"]
    },
    {
      "id": "段13",
      "content": "Case 1：验证aᵣ之前的所有前缀和≤t且避开M'",
      "features": ["前缀和验证"]
    },
    {
      "id": "段14",
      "content": "Case 1：验证到aᵣ处的和为s-aₙ，由r的选取避开M",
      "features": ["前缀和验证", "关键点验证"]
    },
    {
      "id": "段15",
      "content": "Case 1：验证最终和为s∉M",
      "features": ["前缀和验证", "终点验证"]
    },
    {
      "id": "段16",
      "content": "Case 2：由x∉M且∃y∈M,y>x推出|M∩(-∞,x]|≤n-2",
      "features": ["规模估计"]
    },
    {
      "id": "段17",
      "content": "Case 2：构造子问题禁地M'=M∩(-∞,x]",
      "features": ["子问题构造", "截断集合构造"]
    },
    {
      "id": "段18",
      "content": "Case 2：对a₁,...,a_{n-1}与M'应用归纳（和为x∉M'），得排列p'",
      "features": ["归纳应用"]
    },
    {
      "id": "段19",
      "content": "Case 2：退化处理——若M'为空，直接用恒等排列",
      "features": ["空集退化处理", "边界情形处理"]
    },
    {
      "id": "段20",
      "content": "Case 2：在p'后放置aₙ扩展为完整排列",
      "features": ["排列扩展构造", "构造"]
    },
    {
      "id": "段21",
      "content": "Case 2：验证前n-1跳的前缀和≤x且避开M'，最终和为s∉M",
      "features": ["前缀和验证", "终点验证"]
    },
    {
      "id": "段22",
      "content": "Case 3：令z=max(M)，构造子问题禁地M'=M\\{z}",
      "features": ["子问题构造", "去最大元构造"]
    },
    {
      "id": "段23",
      "content": "Case 3：对a₁,...,a_{n-1}与M'应用归纳（|M'|=n-2），得排列p'",
      "features": ["归纳应用"]
    },
    {
      "id": "段24",
      "content": "Case 3：若p'某前缀和在位置k等于z，将位置k与最后位置交换——aₙ放位置k（因aₙ>a_{p'(k)}跳过z），原a_{p'(k)}放最后",
      "features": ["交换构造", "情况分析", "构造"]
    },
    {
      "id": "段25",
      "content": "Case 3：若无前缀和等于z，p'已避开整个M（M=M'∪{z}且z从未被命中）",
      "features": ["情况验证", "前缀和验证"]
    },
    {
      "id": "段26",
      "content": "一般（未排序）情形通过复合排序排列归约到排序情形，闭合WLOG",
      "features": ["WLOG归约闭合", "排列复合"]
    }
  ]
}
