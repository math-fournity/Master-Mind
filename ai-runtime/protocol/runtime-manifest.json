{
  "schema_version": "moira.runtime-manifest.v1",
  "name": "MOIRA Devin CLI Nonlinear Runtime",
  "created_at": "2026-07-10",
  "project_root": "~/MOIRA_chinese_astrology-main",
  "primary_ledgers": {
    "execution_tasks": "tasks.json",
    "todo_truth": "dev-docs/todos.json",
    "master_state": "runtime/master_state.json",
    "factory_state": "runtime/factory_state.json",
    "iteration_state": "runtime/iteration_state.json",
    "absorption_strategy": "runtime/absorption_strategy.json",
    "knowledge_graph": "runtime/knowledge_graph.json"
  },
  "agent_providers": {
    "current": "opencode",
    "future": "devin",
    "switch": "Set MOIRA_AGENT_PROVIDER=devin or pass --provider devin to worker.sh."
  },
  "runtime_dirs": {
    "checkpoints": "runtime/checkpoints",
    "audit_logs": "runtime/audit_logs",
    "prompts": "runtime/prompts",
    "transcripts": "runtime/transcripts",
    "launcher_logs": "runtime/launcher_logs"
  },
  "stop_gate": {
    "queued_tasks": 0,
    "leased_tasks": 0,
    "busy_workers": 0,
    "protocol_remainder": 0
  },
  "path_list_gate": {
    "required_before_book_processing": true,
    "required_artifact": "dev-docs/原典/<书名>/full_path_tree.json",
    "required_evidence": [
      "stable_path_id",
      "source_file",
      "line_range",
      "verifiable_hash_or_locator",
      "coverage_remainder_0"
    ],
    "allowed_without_gate": [
      "build_path_list",
      "audit_path_list"
    ]
  },
  "nonlinear_state_fields": [
    "current_phase",
    "dimension_coverage",
    "lowest_coverage_dimensions",
    "discoveries_count",
    "unknown_concepts_count"
  ]
}
