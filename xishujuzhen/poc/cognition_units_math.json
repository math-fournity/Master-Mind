    {
      "cog_id": "poc_methodology",
      "title": "POC验证方法论",
      "category": "core",
      "status": "active",
      "key_cognition": "POC必须区分静态完整路线重建、结构覆盖、工作认知自洽和动态思维矫正四类命题；旧POC-1/2存在具体答案路线、Master代写、单次运行和评分混杂，只提供局部信号。核心验证改为失败状态上的Hint-0至Hint-2因果干预：角色隔离、冻结输入、重复对照、盲评、跨题迁移和泄漏审计",
      "source_docs": [84, 85, 87, 88, 121, 122],
