# ArangoDB 环境变量 —— glm5.2 worktree 数据库隔离
#
# 复制本文件为 .env，按需修改后 source 或用 dotenv 加载。
#
# 默认值（不设环境变量时的 fallback）和上游 D repo 一致：
#   ARANGO_HOST = http://localhost:8529
#   ARANGO_DB   = xishujuzhen_math
#   ARANGO_USER = root
#   ARANGO_PASS = REDACTED-DB-PASSWORD
#
# 本 worktree 的隔离值：
export ARANGO_HOST="http://localhost:8529"
export ARANGO_DB="xishujuzhen_math_glm52"
export ARANGO_USER="root"
export ARANGO_PASS="REDACTED-DB-PASSWORD"
